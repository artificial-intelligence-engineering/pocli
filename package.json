{
  "name": "pocli",
  "version": "1.0.1",
  "description": "Product Owner CLI (PO CLI) — Linux TUI/CLI Software Engineering Environment with Virtual Agent Team, RAG Notebooks, and Process Sandboxing",
  "type": "module",
  "bin": {
    "pocli": "./dist/cli.js"
  },
  "files": [
    "dist",
    "behavior",
    "data",
    "install.sh",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc && node -e \"const fs=require('node:fs'); fs.cpSync('behavior','dist/behavior',{recursive:true}); fs.cpSync('data','dist/data',{recursive:true}); fs.chmodSync('dist/cli.js', 0o755);\"",
    "prepack": "npm run build",
    "pocli": "tsx src/cli.ts",
    "start": "tsx src/cli.ts",
    "tui": "tsx src/cli.ts tui",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "dependencies": {
    "ink": "^5.1.0",
    "react": "^18.3.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@types/react": "^18.3.18",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.6"
  }
}

